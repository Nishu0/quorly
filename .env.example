# ---------- Database (Neon / any Postgres) ----------
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------- Privy ----------
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""
# P-256 authorization key (base64 PKCS8) used to sign wallet API requests
PRIVY_AUTHORIZATION_PRIVATE_KEY=""
# Optional: pre-created key quorum id that owns the treasury wallet
PRIVY_TREASURY_QUORUM_ID=""
PRIVY_API_BASE="https://api.privy.io"

# ---------- World ID / Selfie Check ----------
NEXT_PUBLIC_WORLD_APP_ID="app_xxxxxxxxxxxxxxxx"   # Developer Portal -> your app
NEXT_PUBLIC_WORLD_ACTION="approve-payout"         # must exist as an Incognito Action
WORLD_RP_ID="rp_xxxxxxxxxxxxxxxx"                 # Developer Portal -> Relying Parties
WORLD_RP_SIGNING_KEY=""                           # hex secp256k1 key, server-side ONLY
WORLD_ENVIRONMENT="staging"                       # staging while in Sandbox
WORLD_API_BASE="https://developer.world.org"

# ---------- Slack ----------
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."     # Socket Mode
SLACK_SIGNING_SECRET=""

# ---------- AI (invoice parsing + intent routing) ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------- Chain ----------
CHAIN_ID="84532"               # Base Sepolia
RPC_URL="https://sepolia.base.org"
USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# ---------- App ----------
APP_URL="http://localhost:3000"

# ---------- Optional connectors ----------
BILL_DEV_KEY=""
BILL_USERNAME=""
BILL_PASSWORD=""
BILL_ORG_ID=""
BILL_API_BASE="https://gateway.stage.bill.com/connect/v3"

# ---------- Linking Slack accounts to the seeded demo members ----------
# Slack profile -> More -> Copy member ID. Then re-run `bun run seed`.
SEED_SLACK_OWNER=""        # Dana (CFO)
SEED_SLACK_APPROVER=""     # Mel (Eng Manager)
SEED_SLACK_CONTRACTOR=""   # Priya (Contractor)

# ---------- Contract deployment (Base Sepolia) ----------
DEPLOYER_PRIVATE_KEY=""        # funded with Base Sepolia ETH for gas
TREASURY_ADDRESS=""            # seeded with QUSD at deploy time
BASESCAN_API_KEY=""            # optional; Blockscout verification needs no key
QUSD_ADDRESS=""                # filled in after deploy

# Public Privy app id — needed in the browser for login
NEXT_PUBLIC_PRIVY_APP_ID=""

# ---------- Slack OAuth install (multi-workspace) ----------
# Slack app -> Basic Information -> App Credentials
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# ---------- Go server ----------
ADDR=":8080"
