{
  "name": "quorly",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "cd server && go run ./cmd/quorly",
    "build:web": "bun run --cwd apps/web build",
    "migrate": "cd server && go run ./cmd/quorly -migrate",
    "test": "cd server && go test ./...",
    "test:contracts": "cd contracts && forge test",
    "deploy:qusd": "cd contracts && forge script script/DeployQuorlyUSD.s.sol:DeployQuorlyUSD --rpc-url $RPC_URL --broadcast --verify --verifier blockscout --verifier-url https://base-sepolia.blockscout.com/api",
    "typecheck": "bun run --cwd apps/web exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
